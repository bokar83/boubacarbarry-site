# /docs/ is working material, NOT a public surface. Deny it at the edge.
#
# What lives here: design-audit runs with their screenshots, verification
# screenshot sets, and personal portfolio working copy. It sat inside the
# deployed tree, so the host served every file in it to anyone holding the
# path. Nothing links to it, which is not protection.
#
# Same posture as review/.htaccess in this repo: the working area is not
# served to a stranger who happens to hold an address.
#
# Verified before this file was added: no public page on this site
# references any asset under /docs/, so denying it cannot break a page.
#
# The source files stay in the repository. Only public SERVING stops.

Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

# Apache 2.4 / LiteSpeed
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

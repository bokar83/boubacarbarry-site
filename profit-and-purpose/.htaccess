# A gate of its own, separate from /review/.
#
# /review/ is one shared password covering every working page on this domain.
# This address is handed to one person outside the house, so it gets its own
# lock and its own key file. Nothing here can be opened with the /review/
# password, and the /review/ password is not weakened by this existing.
#
# Same shape as review/.htaccess: the web server serves nothing under here
# directly. gate.php hands files over, and only to a request carrying a valid
# signed cookie.

Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /profit-and-purpose/

  # The gate must stay directly reachable or the catch-all below would rewrite
  # it into itself.
  RewriteRule ^gate\.php$ - [L]

  # Hint-add installer exemption. Commented out by default -- installed
  # 2026-09-04. To rotate the hint again: uncomment, deploy, curl
  # _add-hint.php once from the VPS, then re-comment and deploy again.
  # RewriteRule ^_add-hint\.php$ - [L]

  # The one-time key installer that set this gate's password has been removed
  # from the repo again -- 2026-08-21 rotation is done. To rotate again:
  # restore profit-and-purpose/_setup-gate.php from history (it now overwrites
  # an existing key rather than refusing -- see its 2026-08-21 rotation note),
  # re-add the RewriteRule that kept it reachable, deploy, POST the new
  # password to it from the VPS over IPv4, then remove both again.

  RewriteRule ^ gate.php [L]
</IfModule>

# A broken gate should fail shut, not open.
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>

# /review/ is the working area. The pages here carry unfinished thinking,
# named people, and business detail that was never meant to be found by a
# stranger. The password panel on some of these pages is drawn in CSS and
# removed by a class on <body>, so it hides the page from a visitor, not from
# anyone who reads the response. Treat everything under here as readable to
# whoever holds the URL, and keep the URLs from being handed out.

# No directory listings. The server already behaves this way; saying it here
# means it survives a panel change.
Options -Indexes

# The manifest is a build-time file. publish-review.ps1, close-review.ps1,
# prune-reviews.ps1 and rebuild-review-index.ps1 read it to regenerate the
# index; nothing in a browser ever fetches it. Served publicly it is a
# machine-readable list of every review slug and title, including several
# named after real people, which turns "you need the address" into a single
# download. Blocking it costs nothing and closes that.
<Files ".review-manifest.json">
  Require all denied
</Files>

# Same reasoning for any other dotfile that lands here later.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# robots.txt already disallows /review/, but that is a request not to crawl.
# It does not stop a URL found some other way from being indexed, and the
# file itself announces that /review/ exists. This rides on the response, so
# it applies to every page and every attached file underneath.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

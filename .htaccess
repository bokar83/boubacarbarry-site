# The July 30 attendee kit was built here first, then Boubacar chose
# catalystworks.consulting as its home. One page, one URL to maintain, and
# any link already shared for this address keeps working.
#
# The QR on the cards and the closing slide points at the catalystworks URL.
# This exists for the earlier link, not as the route anyone is given.

RewriteEngine On

# The service worker script must keep being served from THIS origin. A
# registered worker only updates by fetching its own script from the same
# origin, and a cross-origin redirect fails that fetch, which would leave the
# old worker installed and still serving its cached copy of the old page. The
# replacement worker at kit/sw.js unregisters itself, so leave it reachable.
RewriteRule ^kit/sw\.js$ - [L]

# Everything else under the old path moves to the new one, keeping the file
# name so a bookmarked slides PDF still resolves.
RewriteRule ^kit/(.+)$ https://catalystworks.consulting/kit/$1 [R=301,L]
RewriteRule ^kit/?$ https://catalystworks.consulting/kit/ [R=301,L]
